{
  "version": 2,
  "builds": [
    {
      "src": "api/gate/close.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "waipl_verification_gate/**"
      }
    },
    {
      "src": "api/gate/verify.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "waipl_verification_gate/**"
      }
    },
    {
      "src": "api/vercel.cjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/gate/close",
      "dest": "api/gate/close.py",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/gate/verify",
      "dest": "api/gate/verify.py",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/voice/speak",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Accept"
      },
      "dest": "api/vercel.cjs"
    },
    {
      "src": "/api/voice/listen",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Accept"
      },
      "dest": "api/vercel.cjs"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/vercel.cjs"
    },
    {
      "src": "/(.+\\.[A-Za-z0-9]+)$",
      "dest": "/"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Permissions-Policy": "microphone=*, geolocation=(self)"
      },
      "dest": "/index.html"
    }
  ]
}
