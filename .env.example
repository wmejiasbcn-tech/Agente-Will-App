# GEMINI_API_KEY: Primary Gemini API key.
# AI Studio may inject this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# XAI_API_KEY: Fallback conversation model (xAI/Grok) and STT path.
# If GEMINI_API_KEY is absent, the backend may use xAI/Grok instead.
# Inject in the runtime environment; do not commit real secrets.
XAI_API_KEY="MY_XAI_API_KEY"

# TTS de producción: ElevenLabs, voz DrwFQsjvHFpLcKyvtbE3.
# ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# WAIPL Verification Gate (Node <-> Python Function)
GATE_SHARED_SECRET=
GATE_PYTHON_BASE_URL=
GATE_HTTP_TIMEOUT_MS=15000

